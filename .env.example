###############################################################################
# „Намери Техник“ — примерни настройки
#
# Копирай този файл като .env и попълни реалните стойности:
#   cp .env.example .env && php artisan key:generate
#
# НИКОГА не качвай .env с реални данни в хранилището.
###############################################################################

APP_NAME="Намери Техник"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=bg
APP_FALLBACK_LOCALE=bg
APP_FAKER_LOCALE=bg_BG
APP_TIMEZONE=Europe/Sofia

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- База данни -------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nameri_tehnik
DB_USERNAME=root
DB_PASSWORD=

# --- Сесии, кеш, опашки -----------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Поща -------------------------------------------------------------------
# За локална разработка MAIL_MAILER=log записва писмата в storage/logs.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@nameritehnik.bg"
MAIL_FROM_NAME="${APP_NAME}"

# --- Бизнес настройки на платформата ---------------------------------------
NT_CONTACT_EMAIL=info@nameritehnik.bg
NT_CONTACT_PHONE="+359 700 00 000"
NT_ADMIN_EMAIL=admin@nameritehnik.bg
# Парола на администратора, създаван от seeder-а. Смени я след първо влизане.
NT_ADMIN_PASSWORD=parola123

# Цена по подразбиране на заявка (лв.). Цената по категория се задава в админа.
NT_LEAD_PRICE_DEFAULT=15
NT_CURRENCY=BGN

# Качване на файлове
NT_UPLOAD_MAX_KB=5120

# Защита от спам и дубликати
NT_DUPLICATE_WINDOW=30
# Cloudflare Turnstile. Без ключове проверката се пропуска (локална среда).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# GDPR — дни, след които данните по заявка се анонимизират
NT_RETENTION_DAYS=730

# Платежен канал: manual (по подразбиране). Stripe/myPOS се добавят по-късно.
NT_PAYMENT_GATEWAY=manual
NT_BANK_HOLDER=
NT_BANK_IBAN=
NT_BANK_BIC=

# --- Matching алгоритъм (точки по критерий) ---------------------------------
MATCH_W_CATEGORY=30
MATCH_W_EQUIPMENT_TYPE=15
MATCH_W_SAME_CITY=30
MATCH_W_SERVICE_AREA=25
MATCH_W_WITHIN_RADIUS=20
MATCH_W_SAME_REGION=10
MATCH_W_OPERATOR=10
MATCH_W_VERIFIED=10
MATCH_W_RATING=5
MATCH_MINIMUM_SCORE=30
MATCH_SUGGESTED_PROVIDERS=5
MATCH_DEFAULT_RADIUS_KM=50
# В MVP администраторът избира доставчиците ръчно.
MATCH_AUTO_DISPATCH=false

# --- Анализ -----------------------------------------------------------------
NT_GA_MEASUREMENT_ID=

VITE_APP_NAME="${APP_NAME}"
